# Copy to config.env (git-ignored) and fill in your values.
# Used by scripts/deploy.sh, scripts/pull_prompts.sh, scripts/push_prompts.sh.

# Orchestrator (Mumbai)
ORCH_FUNCTION=your-orchestrator-function-name
ORCH_REGION=ap-south-1
ORCH_ARCH=x86_64            # or arm64, see Lambda > Code > Runtime settings

# Research (Oregon)
RESEARCH_FUNCTION=company-intelligence-web-research
RESEARCH_REGION=us-west-2

# Prompts bucket
S3_BUCKET=company-intelligence-2026
S3_REGION=ap-south-1

# Optional: AWS CLI profile to use
AWS_PROFILE=default
